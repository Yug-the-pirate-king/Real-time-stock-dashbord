# StockPulse Backend Environment Variables
# Copy this file to `.env` and fill in any optional keys you have.

# Server
APP_NAME="StockPulse Trading Engine"
DEBUG=false

# Database (optional — if omitted, SQLite is used)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# API Keys (all optional)
FINNHUB_API_KEY=d87v551r01qmhakhgmd0d87v551r01qmhakhgmdg
EXCHANGE_RATE_API_KEY=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# Cache TTLs (seconds)
PRICE_CACHE_TTL=30
SEARCH_CACHE_TTL=60
NEWS_CACHE_TTL=600
BRIEF_CACHE_TTL=300
ALERTS_CACHE_TTL=120
INFO_CACHE_TTL=300
RATE_CACHE_TTL=3600

# WebSocket
WEBSOCKET_TICK_SECONDS=5
MAX_WEBSOCKET_SUBSCRIPTIONS=50

# Feature flags
ENABLE_AI_CHAT=false
ENABLE_PAPER_COMPETITIONS=false
ENABLE_OPTIONS=false

# Paper trading
STARTING_BALANCE=100000.0
